  "database": {
    "type": "sqlite",
    "path": "tmp/usb_threats.db",
    "backup_interval_hours": 6,
    "max_size_mb": 1000,
    "vacuum_interval_hours": 24
  },
  "logging": {
    "level": "INFO",
    "file": "tmp/usb_threat_engine.log",
    "max_size_mb": 100,
    "backup_count": 5,
    "mtp_debug": false,
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s"
  },
  "device_categories": {
