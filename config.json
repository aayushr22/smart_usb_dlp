      ".mp3",
      ".wav",
      ".flac",
      ".aac",
      ".ogg",
      ".wma",
      ".pdf",
      ".doc",
      ".docx",
      ".xls",
      ".xlsx",
      ".ppt",
      ".txt",
      ".csv",
      ".zip",
      ".rar",
      ".7z",
      ".apk",
      ".exe",
      ".msi",
      ".deb",
      ".rpm"
