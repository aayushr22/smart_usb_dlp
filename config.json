  "splunk_integration": {
    "enabled": false,
    "host": "localhost",
    "port": 8089,
    "username": "admin",
    "password": "password",
    "index": "usb_security",
    "sourcetype": "usb:threat",
    "ssl_verify": false,
    "timeout": 30,
    "retry_count": 3,
    "batch_size": 100
  },
  "splunk": {
    "host": "localhost",
    "port": 8089,
    "username": "admin",
    "password": "password",
    "index": "usb_security",
    "sourcetype": "usb:threat",
    "ssl_verify": false,
    "timeout": 30,
    "retry_count": 3,
    "batch_size": 100
