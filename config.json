    "monitor_folders": [
      "DCIM",
      "Pictures",
      "Documents",
      "Downloads",
      "Music",
      "Videos",
      "Android/data"
    ],
    "detect_file_operations": [
      "copy_from_device",
      "copy_to_device",
      "delete_from_device",
      "create_folder",
      "delete_folder",
      "rename_file"
    ]
